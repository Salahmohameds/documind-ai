# Where the frontend's route handlers (app/api/*) send traffic.
#
# These are read server-side only — they are never exposed to the browser,
# which talks exclusively to /api/... on this app's own origin. See
# lib/server/backend.ts.

# ── Routing mode ────────────────────────────────────────────────────────────
# "gateway" (default) sends everything through api-gateway, which enforces JWT
# auth. "direct" bypasses it and calls each service on its own port — the
# escape hatch for working on one service in isolation, or for reverting if the
# Gateway turns out to be the problem.
#
# In direct mode there is no authentication and no /qa endpoint; /api/qa falls
# back to making the search and answer calls itself.
DOCUMIND_API_MODE=gateway

# api-gateway (services/api-gateway). Everything the UI needs is mounted here
# at the same path the downstream service uses.
# Run it with: uvicorn app.main:app --port 8000
GATEWAY_URL=http://localhost:8011

# ── Individual services ─────────────────────────────────────────────────────
# Used in two places: DOCUMIND_API_MODE=direct, and the health report, which
# asks each service for its own /readiness because the Gateway has no
# per-service health aggregation to ask instead.

# document-service (services/document-service).
# Run it with: uvicorn app.main:app --port 8081
DOCUMENT_SERVICE_URL=http://localhost:8081

# search-service (services/search-service).
# docker-compose.yml publishes it on 8080.
SEARCH_SERVICE_URL=http://localhost:8080

# ai-service (services/ai-service) — classification, extraction, PII, risk, and
# the written answer generated from passages search-service retrieved.
# docker-compose.yml publishes it on 8082. With no provider credential
# configured it starts in AI_BACKEND=mock and still serves every endpoint.
AI_SERVICE_URL=http://localhost:8082

# search-service rejects every non-probe request without a bearer token unless
# it is started with DISABLE_AUTH=true. Only consulted in direct mode — in
# gateway mode the session JWT is the credential. Leave empty for local
# development.
SEARCH_SERVICE_TOKEN=

# How long a service gets to answer before the route reports it unavailable.
BACKEND_TIMEOUT_MS=10000
