terraform.rc
# tfvars: only *.tfvars.example may be committed
*.tfvars
!*.tfvars.example
# remote backend config: only backend.hcl.example may be committed
backend.hcl
!backend.hcl.example

# ---- Secrets / keys (never commit) ----
*.pem
*.key
*.p12
*.pfx
*.crt
.env
.env.*
!.env.example
.oci/
.oci-s3-credentials
*credentials*
kubeconfig
kubeconfig_*

# ---- Kubernetes local artifacts ----
*.kubeconfig

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

