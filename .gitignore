# ---- Terraform ----
**/.terraform/
**/.terraform/*
**/*.tfstate
**/*.tfstate.*
**/*.tfstate.backup
**/*.tfplan
**/tfplan
**/tfplan-*
**/crash.log
**/crash.*.log
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json
.terraformrc
terraform.rc
# tfvars: only *.tfvars.example may be committed
**/*.tfvars
!**/*.tfvars.example
# remote backend config: only backend.hcl.example may be committed
**/backend.hcl
!**/backend.hcl.example

# ---- Secrets / keys (never commit) ----
*.pem
*.key
*.p12
*.pfx
*.crt
.env
.env.*
!.env.example
.oci/
.oci-s3-credentials
*credentials*
kubeconfig
kubeconfig_*

# ---- Kubernetes local artifacts ----
*.kubeconfig

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node ----
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs & temp ----
*.log
logs/
tmp/
.temp/

# ---- Deployment artifacts (never commit) ----
artifacts/
*.tfbackend

# Generated test corpus - reproducible from tests/fixtures/generator
# with the seed recorded in manifest. json. Do not commit the artifacts.
tests/fixtures/documents/
tests/fixtures/text/
tests/fixtures/ground-truth/
# ---- Local service runtime state (never commit) ----
# search-service persists its `memory`/`local` vector store here; it is rebuilt
# by re-indexing and holds whatever documents that machine happened to index.
services/search-service/local_vector_store.json
# document-service's local storage backend when STORAGE_TYPE=local.
.local-storage/

# Load test output
tests/load/results/
