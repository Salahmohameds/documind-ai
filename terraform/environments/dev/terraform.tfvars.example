# terraform.tfvars.example — Dev Environment
# ──────────────────────────────────────────────────────────────────────────────
# Copy to terraform.tfvars and fill in YOUR OCI values. NEVER commit this file.
#
# How to get each value:
#   tenancy_ocid     → OCI Console → Administration → Tenancy Details
#   user_ocid        → OCI Console → Profile → User Settings
#   fingerprint      → OCI Console → Profile → API Keys
#   private_key_path → Path to your .pem file
#   region           → Your OCI region identifier
#   compartment_id   → OCI Console → Identity → Compartments
#   object_storage_namespace → Run: oci os ns get
#   availability_domain      → Run: oci iam availability-domain list
#   node_image_id    → Find Oracle-Linux-8.10 OKE image for your K8s version
# ──────────────────────────────────────────────────────────────────────────────

# ─── OCI Provider ────────────────────────────────────────────────────────────
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaXXXXXX"
user_ocid        = "ocid1.user.oc1..aaaaaaaaXXXXXX"
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "me-jeddah-1"

# ─── Compartment ─────────────────────────────────────────────────────────────
compartment_id = "ocid1.compartment.oc1..aaaaaaaaXXXXXX"

# ─── Environment ─────────────────────────────────────────────────────────────
environment = "dev"

# ─── Networking (matches architecture diagram) ──────────────────────────────
vcn_cidr      = "10.20.0.0/16"
vcn_dns_label = "documind"
subnet_cidrs = {
  public      = "10.20.1.0/24"
  oke_workers = "10.20.10.0/24"
  oke_pods    = "10.20.11.0/24"
  data        = "10.20.30.0/24"
}

# ─── OKE ─────────────────────────────────────────────────────────────────────
# Check available versions: oci ce node-pool-options get --node-pool-option-id all
kubernetes_version = "v1.33.10"
node_shape         = "VM.Standard.E4.Flex"
node_ocpus         = 2
node_memory_gbs    = 16
node_pool_size     = 2
max_pods_per_node  = 31

# Find image: oci ce node-pool-options get --node-pool-option-id all --compartment-id <COMPARTMENT_OCID>
# Use Oracle-Linux-8.10-<date>-OKE-<k8s_version> for your region
node_image_id = "ocid1.image.oc1.me-jeddah-1.aaaaaaaaXXXXXX"

# Run: oci iam availability-domain list --compartment-id <COMPARTMENT_OCID>
availability_domain = "oXVt:ME-JEDDAH-1-AD-1"

# Optional: SSH public key for node access
ssh_public_key = ""

# ─── Object Storage ─────────────────────────────────────────────────────────
# Run: oci os ns get
object_storage_namespace = "XXXXXXXX"

# ─── Database ────────────────────────────────────────────────────────────────
# Min 12 chars, must include upper, lower, digit, special character
db_admin_password = "CHANGE_ME_Str0ng!P@ss"
db_shape          = "PostgreSQL.VM.Standard.E4.Flex.2.32GB"

# ─── Load Balancer ───────────────────────────────────────────────────────────
lb_min_bandwidth = 10
lb_max_bandwidth = 100

# ─── Monitoring ──────────────────────────────────────────────────────────────
alert_emails = ["your-email@example.com"]

# ─── OCIR ────────────────────────────────────────────────────────────────────
ocir_repo_prefix = "documind"
